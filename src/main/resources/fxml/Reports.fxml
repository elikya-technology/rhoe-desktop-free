<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1000.0" styleClass="root" stylesheets="@../css/light_theme.css" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tech.elikya.apps.rhoe.desk.controller.ReportsController">
   <children>
      <AnchorPane prefHeight="60.0" prefWidth="400.0" styleClass="stage-header-container" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="title" layoutX="51.0" layoutY="22.0" styleClass="stage-header-text" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="15.0" />
            <JFXButton fx:id="close" cancelButton="true" contentDisplay="CENTER" focusTraversable="false" layoutX="424.0" layoutY="15.0" styleClass="button-hamburger" text=" " AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
               <graphic>
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/close.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="15.0" layoutY="64.0" style="-fx-border-color: #9e9e9e;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <children>
            <AnchorPane prefHeight="26.0" prefWidth="278.0" styleClass="pane-search" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="10.0">
               <children>
                  <CustomTextField fx:id="searchField" prefHeight="26.0" prefWidth="250.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="0.0" />
                  <JFXButton fx:id="searchBtn" contentDisplay="CENTER" focusTraversable="false" styleClass="btn-search" text=" " visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/clear.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </JFXButton>
               </children>
            </AnchorPane>
            <TableView fx:id="reportsTable" layoutX="16.0" layoutY="41.0" prefHeight="200.0" prefWidth="1100.0" tableMenuButtonVisible="true" AnchorPane.bottomAnchor="65.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="40.0">
              <columns>
                  <TableColumn fx:id="saleNumber" prefWidth="75.0" text="C1" />
                  <TableColumn fx:id="saleDate" prefWidth="75.0" text="Column X" />
                  <TableColumn fx:id="saleTime" prefWidth="75.0" text="Column X" />
                <TableColumn fx:id="prodName" prefWidth="75.0" text="C1" />
                <TableColumn fx:id="prodSerNumber" prefWidth="75.0" text="C2" />
                  <TableColumn fx:id="prodNumber" prefWidth="75.0" text="Column X" />
                  <TableColumn fx:id="prodUnitPrice" prefWidth="75.0" text="Column X" />
                  <TableColumn fx:id="quantity" prefWidth="75.0" text="Column X" />
                  <TableColumn fx:id="price" prefWidth="75.0" text="Column X" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <contextMenu>
                  <ContextMenu>
                    <items>
                      <MenuItem fx:id="export" disable="true" mnemonicParsing="false" text="Unspecified Action" />
                        <MenuItem fx:id="_exportAll" disable="true" mnemonicParsing="false" text="Unspecified Action" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="deleteSale" disable="true" mnemonicParsing="false" text="Unspecified Action" />
                    </items>
                  </ContextMenu>
               </contextMenu>
            </TableView>
            <HBox spacing="20.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="15.0">
               <children>
                  <JFXTextField fx:id="salesNumber" editable="false" prefWidth="120.0" promptText="Price" />
                  <JFXTextField fx:id="productsNumber" editable="false" prefWidth="120.0" promptText="Price" />
                  <JFXTextField fx:id="productQty" editable="false" prefWidth="120.0" promptText="Price" />
                  <JFXTextField fx:id="totalPriceET" editable="false" prefHeight="26.0" prefWidth="120.0" promptText="Price" />
                  <JFXTextField fx:id="totalPriceIT" editable="false" prefWidth="120.0" promptText="Price" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
